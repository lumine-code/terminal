{
  "name": "terminal",
  "author": "lumine-code",
  "main": "./lib/terminal",
  "version": "1.0.0",
  "description": "An embedded terminal emulator.",
  "keywords": [
    "xterm",
    "shell",
    "tty",
    "pty",
    "bash",
    "powershell",
    "cmd",
    "node-pty"
  ],
  "files": [
    "lib",
    "keymaps",
    "menus",
    "shell-integration",
    "styles"
  ],
  "repository": "https://github.com/lumine-code/terminal",
  "bugs": {
    "url": "https://github.com/lumine-code/terminal/issues"
  },
  "homepage": "https://github.com/lumine-code/terminal#readme",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0",
    "node": ">=24"
  },
  "backgroundTips": [
    "You can open a terminal beside your code with {{ 'terminal:focus' | keystroke }}",
    "You can run the selected text in a terminal with {{ 'terminal:run-selected-text' | keystroke }}"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "activationHooks": [
    "core:loaded-shell-environment"
  ],
  "deserializers": {
    "TerminalModel": "deserializeTerminalModel"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@lumine-code/etch": "https://github.com/lumine-code/etch.git#9c74208ad932e0694cb3f7ad575e7205154dea8f",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "fs-extra": "^11.4.0",
    "ndjson": "^2.0.0",
    "which": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lumine-code/temp": "https://github.com/lumine-code/node-temp.git#929dfd04196566b21baef93fddc24a19db329bd0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  },
  "providedServices": {
    "terminal": {
      "description": "Run commands and open terminals.",
      "versions": {
        "1.0.0": "provideTerminal"
      }
    }
  }
}
