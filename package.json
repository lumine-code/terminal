{
  "name": "terminal",
  "author": "lumine-code",
  "main": "./lib/terminal",
  "files": [
    "docs",
    "keymaps",
    "lib",
    "menus",
    "shell-integration",
    "spec",
    "styles"
  ],
  "version": "1.0.0",
  "description": "An embedded terminal emulator.",
  "keywords": [
    "xterm",
    "shell",
    "tty",
    "pty",
    "bash",
    "powershell",
    "cmd",
    "node-pty"
  ],
  "repository": "https://github.com/lumine-code/terminal",
  "bugs": {
    "url": "https://github.com/lumine-code/terminal/issues"
  },
  "homepage": "https://github.com/lumine-code/terminal#readme",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0",
    "node": ">=24"
  },
  "backgroundTips": [
    "You can open a terminal beside your code with {{ 'terminal:open' | keystroke }}",
    "You can run the selected text in a terminal with {{ 'terminal:run-selected-text' | keystroke }}"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "activationHooks": [
    "core:loaded-shell-environment"
  ],
  "deserializers": {
    "TerminalModel": "deserializeTerminalModel"
  },
  "dependencies": {
    "@lumine-code/etch": "github:lumine-code/etch#e2736a828e195b7f4878224c03391244c7404ee6",
    "@lumine-code/node-pty": "github:lumine-code/node-pty#f23a53bdc9aac16ff4779cda071699aca9146d2a",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "fs-extra": "^11.4.0",
    "ndjson": "^2.0.0",
    "which": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lumine-code/temp": "github:lumine-code/node-temp#bbd9e24a78e835e7421c8acec360731eafa4d3f6",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  },
  "allowScripts": {
    "github:lumine-code/node-pty#f23a53bdc9aac16ff4779cda071699aca9146d2a": true
  },
  "providedServices": {
    "terminal": {
      "description": "Run commands and open terminals.",
      "versions": {
        "1.0.0": "provideTerminal"
      }
    }
  },
  "consumedServices": {
    "mcp.bridge": {
      "versions": {
        "^1.1.0": "consumeMcpBridge"
      }
    }
  }
}
