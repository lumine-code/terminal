{
  // `ctrl-`` is a cross-editor convention, so it stays out of the alt- tier.
  // Focus and unfocus are two commands rather than one toggle-focus because
  // focus also creates a terminal when none is open; the pair reads as a
  // toggle because the `terminal-view` binding below is on a deeper element.
  "lumine-workspace": {
    "ctrl-`": "terminal:focus",
    "ctrl-~ n": "terminal:open",
    "ctrl-~ up": "terminal:open-split-up",
    "ctrl-~ down": "terminal:open-split-down",
    "ctrl-~ left": "terminal:open-split-left",
    "ctrl-~ right": "terminal:open-split-right",
    "ctrl-~ b": "terminal:open-bottom-dock",
    "ctrl-~ l": "terminal:open-left-dock",
    "ctrl-~ r": "terminal:open-right-dock"
  },
  // These two read the active editor's selection rather than acting on a
  // terminal, so they belong where that selection is.
  "lumine-text-editor:not([mini])": {
    "ctrl-~ x": "terminal:run-selected-text",
    "ctrl-~ i": "terminal:insert-selected-text"
  },
  "terminal-view": {
    // Ten chords opened a terminal and none closed or restarted one, so both
    // were reachable from the menu alone. They sit here rather than at
    // workspace scope because they act on the terminal that has focus.
    "ctrl-~ w": "terminal:close",
    "ctrl-~ s": "terminal:restart",
    "ctrl-l": "terminal:clear",
    "cmdorctrl-f": "terminal:find",
    "cmdorctrl-e": "terminal:set-selection-as-find-pattern",
    "ctrl-`": "terminal:unfocus",
    "cmdorctrl-g": "terminal:find-next",
    "cmdorctrl-shift-g": "terminal:find-previous"
  },
  ".platform-darwin terminal-view": {
    "cmd-alt-k": "terminal:clear"
  },
  ".platform-win32 terminal-view, .platform-linux terminal-view": {
    "f3": "terminal:find-next",
    "shift-f3": "terminal:find-previous"
  },
  ".terminal-find-palette lumine-text-editor": {
    "cmdorctrl-f": "terminal:find",
    "cmdorctrl-g": "terminal:find-next",
    "cmdorctrl-shift-g": "terminal:find-previous"
  },
  ".platform-win32 .terminal-find-palette lumine-text-editor, .platform-linux .terminal-find-palette lumine-text-editor": {
    "f3": "terminal:find-next",
    "shift-f3": "terminal:find-previous"
  }
}
